# Copy to staging.env (gitignored) and fill in. Load with:
#   set -a; source staging/staging.env; set +a

# --- Stellar (source) -------------------------------------------------------
STAGING_STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STAGING_STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
# S... secret of a funded account holding the fee token
STAGING_STELLAR_SENDER_SECRET=
STAGING_STELLAR_ROUTER=
# Optional: resolved via Router.get_onramp(dest) when empty
STAGING_STELLAR_ONRAMP=
# Must be priced on the FeeQuoter (check its get_fee_tokens); the current testnet env only supports LINK
STAGING_STELLAR_FEE_TOKEN=CDFAZQDPCAIC7ZAK22ZT66N3HM3AXNMUAKOTPASEEKM5O4VZKIEUJJDV
# Comma-separated CCV contracts, typically the VersionedVerifierResolver
STAGING_STELLAR_CCVS=
# Optional: concrete executor; empty uses the lane's default executor
STAGING_STELLAR_EXECUTOR=
# true for Routers built before bbc2d2b4 (ccip_send takes a trailing fee_token_amount).
# The current testnet Router needs this until it is redeployed.
STAGING_ROUTER_LEGACY_FEE_ARG=true

# --- Lane -------------------------------------------------------------------
# Defaults: stellar-testnet -> ethereum-testnet-sepolia
STAGING_SOURCE_CHAIN_SELECTOR=4894814558906953166
STAGING_DEST_CHAIN_SELECTOR=16015286601757825753
# ccipReceive gas on the destination. 0 only works for EOA receivers; a contract
# receiver given 0 fails with ReceiverError(0x).
STAGING_EVM_GAS_LIMIT=200000
STAGING_SEND_BATCH_SIZE=3
STAGING_SENT_EVENT_TIMEOUT=2m

# --- EVM (destination) ------------------------------------------------------
STAGING_EVM_RECEIVER=
# Optional: set both to wait for ExecutionStateChanged on the destination
STAGING_EVM_RPC_URL=
STAGING_EVM_OFFRAMP=
STAGING_EVM_EXEC_TIMEOUT=30m
STAGING_EVM_LOG_LOOKBACK_BLOCKS=50

# --- EVM -> Stellar (evm_to_stellar_send_test.go) ----------------------------
# Also uses STAGING_EVM_RPC_URL (required here), STAGING_STELLAR_SENDER_SECRET
# (only for read-only simulations), STAGING_STELLAR_ROUTER, STAGING_SEND_BATCH_SIZE
# and the two lane selectors above (SOURCE = Stellar end, DEST = EVM end).
# Hex secp256k1 key of a Sepolia account holding ETH (and the fee token, if ERC-20)
STAGING_EVM_SENDER_PRIVATE_KEY=
STAGING_EVM_ROUTER=0x140ce0d34f9eaa4b475a0184d47fc71dcb67c8d9
# Empty pays the fee in native ETH; or an ERC-20 the FeeQuoter accepts (e.g. 0xe4Be9157410f2bede39B24dBcF98C1ab5dfF6706)
STAGING_EVM_FEE_TOKEN=
# Contract implementing ccip_receive (C... or 0x 32-byte hex). It must have
# enabled the EVM chain (enable_remote_chain) or execution fails.
STAGING_STELLAR_RECEIVER=CAQVG6KGJWTEHOXBVRFBBHRXTVI4SK5KACSW7IHF7YM42B5V6X6OI4FK
# Optional: resolved via the Stellar Router's get_offramps when empty
STAGING_STELLAR_OFFRAMP=
STAGING_STELLAR_GAS_LIMIT=200000
STAGING_EVM_SENT_TIMEOUT=5m
STAGING_STELLAR_EXEC_TIMEOUT=30m

# --- FLAGS ------------------------------------------------------
# Used to bypass the outdated router deployment which includes an extra
# param in `ccip_send`
STAGING_ROUTER_LEGACY_FEE_ARG=true
